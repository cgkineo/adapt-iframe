{
  "type": "object",
  "$schema": "http://json-schema.org/draft-04/schema",
  "id": "http://jsonschema.net",
  "$ref": "http://localhost/plugins/content/component/model.schema",
  "properties": {
    "_supportedLayout": {
      "type": "string",
      "required": true,
      "enum": ["full-width", "half-width", "both"],
      "default": "both",
      "editorOnly": true
    },
    "_setCompletionOn": {
      "type": "string",
      "default": "inview",
      "title": "Set completion on",
      "inputType": {
        "type": "Select",
        "options": [
          "inview",
          "message"
        ]
      },
      "help": "Set completion based on either having scrolled into view or from the embedded content sending a message via the window.postMessage API"
    },
    "instruction": {
      "type": "string",
      "required": false,
      "default": "",
      "inputType": "Text",
      "validators": [],
      "help": "This is the instruction text",
      "translatable": true
    },
    "_src": {
      "type": "string",
      "required": true,
      "title": "URL",
      "default": "",
      "inputType": "Text",
      "validators": ["required"],
      "help": "Path to the page you want to display in the iframe"
    },
    "_initialWidth": {
      "type": "number",
      "required": false,
      "title": "Initial width",
      "inputType": "Number",
      "validators": ["number"],
      "help": "The native width of the iframe contents. Used with the initial height to keep the iframe's aspect ratio as it resizes. If either is left empty, a ratio of 0.56 (16:9) is used"
    },
    "_initialHeight": {
      "type": "number",
      "required": false,
      "title": "Initial height",
      "inputType": "Number",
      "validators": ["number"],
      "help": "The native height of the iframe contents. Used with the initial width to keep the iframe's aspect ratio as it resizes. If either is left empty, a ratio of 0.56 (16:9) is used"
    },
    "_dimensionDelegateSelector": {
      "type": "string",
      "required": false,
      "default": "",
      "inputType": "Text",
      "help": "If the dimensions of the iframe should be delegated to a child element of the iframe, use this attribute to select which child element this is."
    }
  }
}
